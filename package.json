{
  "name": "basic-auth-for-vercel-middleware",
  "version": "1.0.12",
  "description": "Basic Authentication for vercel middleware",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mosle/basic-auth-for-vercel-middleware.git"
  },
  "main": "./build/cjs/index.js",
  "module": "./build/esm/index.js",
  "types": "./build/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/esm/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "require": {
        "types": "./build/cjs/index.d.ts",
        "default": "./build/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('build/esm/package.json','{\\\"type\\\":\\\"module\\\"}\\n')\"",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:build": "node -e \"const m=require('basic-auth-for-vercel-middleware');if(typeof m.createBasicAuthHandler!=='function')process.exit(1)\" && node --input-type=module -e \"import {createBasicAuthHandler as f} from 'basic-auth-for-vercel-middleware';if(typeof f!=='function')process.exit(1)\"",
    "prepare": "yarn build"
  },
  "license": "MIT",
  "keywords": [
    "basicauth",
    "auth",
    "vercel",
    "pages",
    "middleware",
    "functions"
  ],
  "author": {
    "name": "mosle(Yosuke Yasuda)",
    "email": "yskysd@gmail.com"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@vercel/edge": "^1.3.3"
  }
}
